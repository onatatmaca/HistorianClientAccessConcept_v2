<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Historian sync tag name used for gap analysis -->
    <add key="SyncTagName" value="HistSync" />
    <!-- Gap batch size in minutes -->
    <add key="BatchSizeMinutes" value="10" />
    <!-- Max retry attempts on failed API calls -->
    <add key="MaxRetryAttempts" value="3" />
    <!-- Minimum gap duration in seconds — the FLOOR of the per-tag gap rule. Silence
         shorter than this is never a gap, whatever the tag's cadence says. -->
    <add key="MinimumGapSeconds" value="120" />
    <!-- Per-tag gap rule = max(p90 of the tag's own sample intervals × this multiplier,
         MinimumGapSeconds). p90 (not median) because deadband tags legitimately stay
         quiet far longer than their median interval — e.g. a tag logging every ~6 min
         (median) with normal 30-60-min quiet periods gets a ~1-hour gap rule instead
         of flagging every quiet stretch as missing data. -->
    <add key="GapThresholdMultiplier" value="2.0" />
    <!-- Backfill never evaluates the trailing N seconds before "now". On live servers
         the collectors are still writing there, so diffing up to now reports in-flight
         samples as missing on every run — an endless backfill loop. -->
    <add key="LiveEdgeGraceSeconds" value="120" />
    <!-- Optional Historian login. Leave empty to connect with the Windows session
         (works when the tool runs on the Historian server itself). Set both when
         connecting remotely to a server that rejects empty usernames. -->
    <add key="HistorianUsername" value="" />
    <add key="HistorianPassword" value="" />
  </appSettings>
</configuration>
