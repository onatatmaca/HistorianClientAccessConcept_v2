<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Historian sync tag name used for gap analysis -->
    <add key="SyncTagName" value="HistSync" />
    <!-- Gap batch size in minutes -->
    <add key="BatchSizeMinutes" value="10" />
    <!-- Max retry attempts on failed API calls -->
    <add key="MaxRetryAttempts" value="3" />
    <!-- Minimum gap duration in seconds. Deltas shorter than this are NEVER flagged as
         gaps, even if median * 1.5 would say otherwise. Protects against false positives
         on deadband-logged tags where normal intervals vary (e.g., 1s when changing,
         30s when stable). Default 120s = 2 minutes. Raise if you still see noise. -->
    <add key="MinimumGapSeconds" value="120" />
  </appSettings>
</configuration>
